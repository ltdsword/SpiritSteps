%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95257aeb42291f24bb485a8f48045341, type: 3}
  m_Name: PrototypeUiCatalog
  m_EditorClassIdentifier: ARWalking.Runtime::ARWalking.UI.PrototypeUiCatalog
  companions:
  - id: corgi
    name: Corgi
    description: Despite their short legs, Corgis were bred in Wales to herd cattle
      many times their size by nipping at the heels.
    imageKey: corgi
    unlockHint: Starter companion
    unlockDistanceKilometres: 0
  - id: uaa_husky
    name: Husky
    description: Siberian Huskies were bred by Siberia's Chukchi people to pull
      sleds hundreds of kilometres across the Arctic.
    imageKey: uaa_husky
    unlockHint: Walk 1 km total to unlock
    unlockDistanceKilometres: 1
  - id: uaa_fox
    name: Fox
    description: A fox's bushy tail, called a brush, wraps around its body like
      a blanket to keep it warm in winter.
    imageKey: uaa_fox
    unlockHint: Walk 2 km total to unlock
    unlockDistanceKilometres: 2
  - id: uaa_wolf
    name: Wolf
    description: Wolves howl to communicate with pack members who may be miles
      away, and each wolf's howl is unique.
    imageKey: uaa_wolf
    unlockHint: Walk 3 km total to unlock
    unlockDistanceKilometres: 3
  - id: pug
    name: Pug
    description: Pugs were bred as lapdogs for Chinese emperors and later became
      the mascot of the Dutch royal House of Orange.
    imageKey: pug
    unlockHint: Walk 4 km total to unlock
    unlockDistanceKilometres: 4
  - id: chihuahua
    name: Chihuahua
    description: The world's smallest dog breed takes its name from the Mexican
      state of Chihuahua, where it was first documented.
    imageKey: chihuahua
    unlockHint: Walk 5 km total to unlock
    unlockDistanceKilometres: 5
  - id: cur
    name: Shiba Inu (Kit)
    description: Shiba Inu puppies are famously fox-like, a resemblance that helped
      the breed become one of the internet's favourite memes.
    imageKey: cur
    unlockHint: Walk 6 km total to unlock
    unlockDistanceKilometres: 6
  - id: germanshepherd
    name: German Shepherd
    description: German Shepherds are the most widely used dog breed in police and
      military work thanks to their intelligence and drive.
    imageKey: germanshepherd
    unlockHint: Walk 7 km total to unlock
    unlockDistanceKilometres: 7
  - id: uaa_shiba
    name: Shiba Inu
    description: The Shiba Inu is one of Japan's oldest native dog breeds, originally
      kept to flush game from dense mountain brush.
    imageKey: uaa_shiba
    unlockHint: Walk 8 km total to unlock
    unlockDistanceKilometres: 8
  - id: uaa_alpaca
    name: Alpaca
    description: Alpacas hum softly to express emotion and grow some of the warmest,
      softest natural fibre of any animal.
    imageKey: uaa_alpaca
    unlockHint: Walk 9 km total to unlock
    unlockDistanceKilometres: 9
  - id: uaa_deer
    name: Deer
    description: Deer have a reflective layer behind their eyes called the tapetum
      lucidum, giving them excellent night vision.
    imageKey: uaa_deer
    unlockHint: Complete the Central Post Office AR Memory
    unlockDistanceKilometres: 0
  - id: uaa_stag
    name: Stag
    description: A stag's antlers are shed and regrown every single year, making
      them the fastest-growing bone tissue in nature.
    imageKey: uaa_stag
    unlockHint: Walk 10 km total to unlock
    unlockDistanceKilometres: 10
  - id: uaa_donkey
    name: Donkey
    description: Donkeys have remarkably long memories and can recall the locations
      of grazing grounds and other donkeys for decades.
    imageKey: uaa_donkey
    unlockHint: Walk 12 km total to unlock
    unlockDistanceKilometres: 12
  - id: uaa_bull
    name: Bull
    description: Bulls are actually red-green colourblind, so it's the cape's motion,
      not its colour, that draws a charge.
    imageKey: uaa_bull
    unlockHint: Walk 14 km total to unlock
    unlockDistanceKilometres: 14
  - id: uaa_cow
    name: Cow
    description: Cows have almost 360-degree vision and can recognise and remember
      individual human and cow faces.
    imageKey: uaa_cow
    unlockHint: Walk 16 km total to unlock
    unlockDistanceKilometres: 16
  - id: uaa_horse
    name: Horse
    description: Horses can sleep both standing and lying down, thanks to a natural
      locking mechanism in their leg joints.
    imageKey: uaa_horse
    unlockHint: Walk 18 km total to unlock
    unlockDistanceKilometres: 18
  - id: uaa_horse_white
    name: White Horse
    description: Most pale "white" horses are actually greys that lost their colour
      with age, since true white horses are extremely rare.
    imageKey: uaa_horse_white
    unlockHint: Walk 20 km total to unlock
    unlockDistanceKilometres: 20
  foods:
  - id: rice-ball
    name: Rice Ball
    coinCost: 20
    growthExperience: 15
    description: A light onigiri snack any unlocked companion can carry into AR or
      the meadow.
  - id: chicken-leg
    name: Chicken
    coinCost: 50
    growthExperience: 40
    description: A hearty drumstick treat for any unlocked companion.
  landmarks:
  - id: independence-palace
    name: Independence Palace
    localName: Independence Palace
    missionClue:
    missionHint:
    history: "1868-1871: The palace was built during the French colonial period and
      originally named Norodom Palace. It was later known as the Palace of the Governor
      of Cochinchina and the Governor-General's Palace.\n\n1955: The palace was renamed
      Independence Palace under President Ngo Dinh Diem.\n\n1962-1966: After it was
      damaged in a bombing, the palace was rebuilt to a design by architect Ngo Viet
      Thu and completed in 1966.\n\n30 April 1975: Liberation Army tanks entered Independence
      Palace, marking the fall of the Republic of Vietnam government and the end of
      the war, paving the way for national reunification."
    architecture: Independence Palace represents the Vietnamese people's aspiration
      for independence, resilient spirit, and complete victory in the struggle to
      defend the nation.
    didYouKnow: The present palace was designed by architect Ngo Viet Thu.
    imageKey: independence-palace
    imageTargetReady: 0
    companionRewardId: 
  - id: central-post-office
    name: Central Post Office
    localName: Buu dien Trung tam Sai Gon
    missionClue:
    missionHint:
    history: Built in the late nineteenth century, the post office has connected
      residents and travellers across generations.
    architecture: Its long vaulted hall, patterned tile floor, and arched windows
      create a bright civic interior.
    didYouKnow: The building still operates as a post office while welcoming visitors.
    imageKey: post-office
    imageTargetReady: 1
    companionRewardId: uaa_deer
  - id: notre-dame-basilica
    name: Notre-Dame Basilica
    localName: Nha tho Duc Ba Sai Gon
    missionClue: Find an illustrated image showing the front of the cathedral, surrounded
      by trees and greenery, with the blue sky above.
    missionHint: Near the entrance
    history: Construction began on 7 October 1877 and the basilica was completed
      in 1880, designed by French architect Jules Bourard.
    architecture: Through many historical changes, Notre-Dame Cathedral Basilica
      of Saigon has grown beyond a religious building to become the soul and an inseparable
      cultural heritage of the southern city.
    didYouKnow: A cultural and social icon of Ho Chi Minh City.
    imageKey: notre-dame
    imageTargetReady: 1
    companionRewardId: uaa_bull
  - id: landmark-81
    name: Landmark 81
    localName: Landmark 81
    missionClue: Find a photo of Landmark 81 taken from a distance at sunset. Look
      for red lights and a heart near the top, with yellow-white lights below.
    missionHint: Around the building
    history: Construction on the project began in 2014, with Vingroup as the developer.
      The entire complex became fully operational in 2018, becoming the tallest building
      in Vietnam and, at the time, one of the tallest buildings in the world. Standing
      461.2 metres tall, the tower has 81 above-ground floors and rises along the banks
      of the Saigon River.
    architecture: The building's design is inspired by a traditional bundle of bamboo,
      symbolizing unity, resilience, and the indomitable spirit of the Vietnamese people.
      It represents Vietnam's economic growth, strong national capabilities, and ambition
      to reach the global stage in an era of international integration.
    didYouKnow: Landmark 81 is named for its 81 above-ground floors.
    imageKey: landmark-81
    imageTargetReady: 1
    companionRewardId: uaa_stag
  map:
    textureKey: hcm-illustrated
    regionName: District 1, Ho Chi Minh City
    minimumZoom: 1
    maximumZoom: 2.8
    initialFocus: {x: 0.5, y: 0.5}
  markers:
  - id: player
    type: 0
    label: Mock player position
    normalizedPosition: {x: 0.48, y: 0.58}
    targetId: 
  - id: palace
    type: 1
    label: Independence Palace
    normalizedPosition: {x: 0.32, y: 0.45}
    targetId: independence-palace
  - id: post-office
    type: 1
    label: Central Post Office
    normalizedPosition: {x: 0.62, y: 0.42}
    targetId: central-post-office
  - id: basilica
    type: 1
    label: Notre-Dame Basilica
    normalizedPosition: {x: 0.55, y: 0.36}
    targetId: notre-dame-basilica
  - id: landmark-81
    type: 1
    label: Landmark 81
    normalizedPosition: {x: 0.78, y: 0.32}
    targetId: landmark-81
