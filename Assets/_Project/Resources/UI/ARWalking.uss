.app-root {
    flex-grow: 1;
    color: rgb(48, 67, 55);
    background-color: rgb(249, 245, 233);
    -unity-font-definition: url("../../Art/UI/Fonts/Nunito-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(249, 245, 233);
}

.page {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.content-page {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 24px;
}

.name-field {
    margin-top: 10px;
    margin-bottom: 6px;
    font-size: 24px;
    -unity-font-style: bold;
}

.name-field > .unity-text-field__input {
    padding: 16px 18px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(91, 121, 98, 0.25);
    background-color: rgba(255, 253, 247, 0.9);
    min-height: 62px;
}

.screen-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-bottom: 24px;
}

.screen-header {
    min-height: 120px;
    flex-direction: row;
    align-items: center;
    padding-bottom: 18px;
}

.screen-header > .column {
    flex-grow: 1;
    margin-left: 12px;
}

.title {
    font-size: 50px;
    color: rgb(42, 63, 49);
    white-space: normal;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.subtitle {
    font-size: 34px;
    color: rgb(48, 67, 55);
    white-space: normal;
    -unity-font-style: bold;
}

.body {
    font-size: 28px;
    color: rgb(75, 89, 80);
    white-space: normal;
    margin-top: 4px;
    -unity-font-style: bold;
}

.eyebrow {
    font-size: 21px;
    letter-spacing: 1.6px;
    color: rgb(76, 134, 91);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.column {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.card {
    background-color: rgba(255, 253, 247, 0.98);
    border-radius: 30px;
    padding: 26px;
    margin-bottom: 18px;
    border-width: 2px;
    border-color: rgba(91, 121, 98, 0.16);
}

.compact-card {
    padding: 20px 24px;
    margin-bottom: 0;
}

.glass-card {
    background-color: rgba(255, 253, 247, 0.94);
}

.action-button {
    min-height: 78px;
    border-radius: 39px;
    border-width: 0;
    font-size: 28px;
    -unity-font-style: bold;
    margin-top: 14px;
    padding-left: 30px;
    padding-right: 30px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.action-button:active {
    scale: 0.97 0.97;
}

.icon-action-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.icon-action-button #action-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 12px;
}

.icon-action-button .action-label {
    -unity-font-style: bold;
}

.primary-action {
    background-color: rgb(90, 157, 103);
    color: white;
}


.secondary-action {
    background-color: rgb(224, 242, 224);
    color: rgb(53, 103, 64);
    border-width: 2px;
    border-color: rgb(175, 211, 179);
}

.danger-action {
    background-color: rgb(253, 229, 225);
    color: rgb(156, 72, 62);
}

.ghost-action {
    background-color: rgba(255, 255, 255, 0);
    color: rgb(91, 105, 95);
}

.compact-action {
    min-height: 64px;
    margin-top: 6px;
    font-size: 22px;
}

.icon-button {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(80, 106, 84, 0.18);
    background-color: rgba(255, 253, 247, 0.96);
    color: rgb(56, 83, 62);
    font-size: 30px;
    -unity-font-style: bold;
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.icon-button:active {
    scale: 0.94 0.94;
}

.icon-button #icon-image {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    flex-shrink: 0;
    align-self: center;
}

.bottom-nav {
    height: 124px;
    min-height: 124px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    margin-left: 14px;
    margin-right: 14px;
    margin-bottom: 14px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 40px;
    background-color: rgba(255, 253, 248, 0.97);
    border-width: 2px;
    border-color: rgba(69, 95, 75, 0.14);
}

.nav-button {
    width: 18%;
    height: 98px;
    min-height: 64px;
    border-width: 0;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(113, 125, 116);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.nav-button:active {
    scale: 0.94 0.94;
}

.nav-button #nav-icon {
    width: 62px;
    height: 62px;
    min-width: 62px;
    min-height: 62px;
    flex-shrink: 0;
    align-self: center;
}

.nav-button #nav-label {
    font-size: 20px;
    margin-top: 4px;
    -unity-font-style: bold;
}

.selected-nav {
    color: rgb(71, 132, 83);
    background-color: rgb(232, 244, 229);
}


.selected-nav #nav-label {
    -unity-font-style: bold;
}

.map-marker #icon-image {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
}

.raised-nav {
    height: 96px;
    margin-bottom: 13px;
    border-radius: 48px;
    color: white;
    background-color: rgb(91, 159, 104);
    border-width: 6px;
    border-color: rgb(255, 253, 248);
}

.map-page {
    position: relative;
    flex-grow: 1;
}

.map-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(217, 234, 210);
}

.map-canvas, .map-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-top-overlay {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.map-top-overlay .compact-card {
    flex-grow: 1;
    margin-right: 12px;
}

.map-stats {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 18px;
    flex-direction: row;
    align-items: center;
    padding: 16px;
    margin-bottom: 0;
}

.map-stats .metric {
    margin-right: 10px;
}

.map-stats .action-button {
    flex-grow: 1;
    margin-top: 0;
}

.map-controls {
    position: absolute;
    right: 22px;
    top: 250px;
}

.map-controls .icon-button {
    margin-bottom: 14px;
}

.map-top-overlay .icon-button {
    margin-left: 10px;
}

.map-marker {
    position: absolute;
    width: 68px;
    height: 68px;
    min-width: 68px;
    min-height: 68px;
    margin-left: -34px;
    margin-top: -34px;
    border-radius: 34px;
    border-width: 5px;
    border-color: white;
    color: white;
    background-color: rgb(90, 157, 103);
    padding: 0;
    font-size: 32px;
}

.marker-landmark { background-color: rgb(85, 158, 200); }
.marker-player { background-color: rgb(78, 127, 78); width: 78px; height: 78px; margin-left: -39px; margin-top: -39px; }

.metric-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 18px;
}

.metric {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 92px;
}

.metric-value {
    font-size: 38px;
    color: rgb(49, 78, 56);
    -unity-font-style: bold;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
}

.metric-label {
    font-size: 19px;
    color: rgb(97, 110, 100);
    -unity-font-style: bold;
}

.progress-track {
    height: 16px;
    min-height: 16px;
    border-radius: 8px;
    overflow: hidden;
    background-color: rgb(226, 231, 222);
    margin-top: 14px;
}

.progress-fill {
    height: 16px;
    border-radius: 8px;
    background-color: rgb(97, 168, 109);
}

.walk-hero, .companion-banner, .collection-progress {
    background-color: rgb(234, 245, 226);
}

.summary-hero {
    background-color: rgb(255, 241, 197);
}

.discovery-card, .memory-card {
    background-color: rgb(228, 244, 250);
}

.journey-banner {
    background-color: rgb(255, 232, 236);
}

.journey-banner #banner-icon {
    width: 58px;
    height: 58px;
    min-width: 58px;
    min-height: 58px;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.discovery-line {
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 95, 75, 0.10);
}

.discovery-badge {
    width: 54px;
    height: 54px;
    margin-right: 16px;
    border-radius: 27px;
    background-color: rgb(239, 246, 229);
    color: rgb(80, 138, 91);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.permission-row, .list-card {
    flex-direction: row;
    align-items: center;
    padding: 18px;
    border-radius: 22px;
    margin-bottom: 10px;
}

.permission-row #permission-glyph {
    width: 52px;
    font-size: 34px;
    color: rgb(83, 144, 95);
}

.permission-row #permission-check {
    font-size: 28px;
    color: rgb(83, 144, 95);
}

.onboarding-page {
    background-color: rgb(231, 243, 229);
}

.onboarding-art {
    flex-grow: 1;
    min-height: 300px;
}

.onboarding-sheet {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
    padding: 30px;
}

.list-thumb {
    width: 100px;
    height: 100px;
    margin-right: 18px;
    border-radius: 22px;
    background-color: rgb(239, 246, 229);
}

.list-card .action-button {
    width: 100px;
    margin-left: 10px;
}

.ready-card {
    border-color: rgb(235, 172, 65);
    background-color: rgb(255, 246, 214);
}

.reveal-stage {
    min-height: 650px;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 236, 240);
}

.reveal-companion {
    width: 310px;
    height: 360px;
    margin-top: 12px;
    margin-bottom: 18px;
}

.companion-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.companion-card {
    width: 48%;
    min-height: 310px;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: 26px;
    background-color: rgb(255, 253, 247);
    border-width: 2px;
    border-color: rgba(77, 105, 83, 0.16);
    flex-direction: column;
    align-items: stretch;
}

.companion-image {
    height: 200px;
    border-radius: 20px;
    background-color: rgb(236, 246, 229);
    margin-bottom: 12px;
}

.locked-card {
    opacity: 0.52;
    background-color: rgb(231, 229, 222);
}

.companion-stage {
    align-items: center;
    background-color: rgb(232, 245, 229);
}

.detail-companion {
    width: 360px;
    height: 410px;
}

.story-card, .scrapbook-card {
    background-color: rgb(255, 248, 224);
}

.landmark-hero, .journey-detail-image {
    height: 360px;
    border-radius: 28px;
    margin-bottom: 18px;
}

.journey-card {
    min-height: 190px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: 26px;
    background-color: rgb(255, 253, 247);
    border-width: 2px;
    border-color: rgba(77, 105, 83, 0.16);
}

.journey-image {
    width: 160px;
    height: 160px;
    border-radius: 22px;
    margin-right: 18px;
}

.overlay-scrim, .tray-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(28, 43, 32, 0.50);
    justify-content: center;
    align-items: center;
    padding: 32px;
}

.tray-scrim {
    justify-content: flex-end;
    padding: 0;
}

.modal-card {
    width: 100%;
    max-width: 620px;
    padding: 30px;
}

.discovery-tray {
    width: 100%;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
    padding: 30px;
}

.toast {
    max-width: 680px;
    min-height: 68px;
    margin: 24px;
    padding: 18px 26px;
    border-radius: 32px;
    background-color: rgb(45, 65, 51);
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ar-page {
    position: relative;
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(35, 54, 41);
}

.ar-backdrop, .photo-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: -80px;
    bottom: -80px;
}

.ar-top-bar {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 20px;
    flex-direction: row;
    align-items: center;
}

.ar-top-bar > .column, .ar-top-bar > .title {
    flex-grow: 1;
    margin-left: 12px;
    color: white;
}

.ar-top-bar .title, .ar-top-bar .ar-alert {
    color: white;
}

.ar-alert {
    font-size: 19px;
    -unity-font-style: bold;
    background-color: rgba(37, 51, 40, 0.64);
    border-radius: 17px;
    padding: 7px 12px;
    white-space: normal;
}

.ar-guide {
    position: absolute;
    left: 60px;
    right: 60px;
    top: 145px;
    min-height: 62px;
    justify-content: center;
    align-items: center;
    border-radius: 31px;
    background-color: rgba(255, 253, 247, 0.90);
    padding: 12px 22px;
}

.ar-companion {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 31%;
    bottom: 19%;
}

.ar-bottom-controls {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.camera-shutter {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    border-width: 8px;
    border-color: white;
    color: white;
    background-color: rgba(255, 255, 255, 0.25);
    font-size: 48px;
}

.photo-companion {
    position: absolute;
    width: 42%;
    height: 48%;
    left: 29%;
    top: 25%;
}

.photo-caption-card {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 132px;
    padding: 18px;
    border-radius: 20px;
    background-color: rgba(255, 253, 247, 0.92);
}

.photo-actions {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;
    flex-direction: row;
}

.photo-actions .action-button {
    flex-grow: 1;
    margin-left: 5px;
    margin-right: 5px;
}

.activity-dashboard-button {
    margin-right: 10px;
}

.activity-hero, .weekly-chart-card {
    background-color: rgb(234, 245, 226);
}

.activity-progress-label-row {
    margin-top: 6px;
}

.weekly-chart {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
    margin-bottom: 4px;
}

.weekly-chart-column {
    align-items: center;
    flex-grow: 1;
}

.weekly-chart-bar-track {
    width: 32px;
    height: 132px;
    border-radius: 16px;
    background-color: rgba(91, 121, 98, 0.10);
    overflow: hidden;
    justify-content: flex-end;
}

.weekly-chart-bar-fill {
    width: 100%;
    border-radius: 16px;
    background-color: rgb(180, 214, 174);
}

.weekly-chart-bar-fill-today {
    background-color: rgb(71, 132, 83);
}

.weekly-chart-bar-fill-future {
    background-color: transparent;
}

.weekly-chart-day-label {
    font-size: 18px;
    color: rgb(97, 110, 100);
    margin-top: 8px;
    -unity-font-style: bold;
}

.weekly-chart-date-label {
    font-size: 20px;
    color: rgb(49, 78, 56);
    -unity-font-style: bold;
}

.weekly-chart-today-label {
    color: rgb(71, 132, 83);
}

.average-pill {
    align-items: center;
    justify-content: center;
    margin-top: 14px;
    padding: 14px;
    border-radius: 22px;
    background-color: rgba(255, 253, 247, 0.85);
}

.average-pill-text {
    font-size: 23px;
    color: rgb(53, 103, 64);
    -unity-font-style: bold;
}
