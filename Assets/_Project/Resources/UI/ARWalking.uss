.app-root {
    flex-grow: 1;
    color: rgb(48, 67, 55);
    background-color: rgb(249, 245, 233);
    -unity-font-definition: url("../../Art/UI/Fonts/Nunito-VariableFont_wght.ttf");
}

.safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(249, 245, 233);
}

.page {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.content-page {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 20px;
}

.screen-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-bottom: 24px;
}

.screen-header {
    min-height: 96px;
    flex-direction: row;
    align-items: center;
    padding-bottom: 16px;
}

.screen-header > .column {
    flex-grow: 1;
    margin-left: 12px;
}

.title {
    font-size: 38px;
    color: rgb(42, 63, 49);
    white-space: normal;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.subtitle {
    font-size: 25px;
    color: rgb(48, 67, 55);
    white-space: normal;
    -unity-font-style: bold;
}

.body {
    font-size: 20px;
    color: rgb(93, 105, 96);
    white-space: normal;
    margin-top: 3px;
}

.eyebrow {
    font-size: 16px;
    letter-spacing: 1.4px;
    color: rgb(76, 134, 91);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.column {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.card {
    background-color: rgba(255, 253, 247, 0.98);
    border-radius: 28px;
    padding: 24px;
    margin-bottom: 18px;
    border-width: 1px;
    border-color: rgba(91, 121, 98, 0.13);
}

.compact-card {
    padding: 18px 22px;
    margin-bottom: 0;
}

.glass-card {
    background-color: rgba(255, 253, 247, 0.94);
}

.action-button {
    min-height: 54px;
    border-radius: 27px;
    border-width: 0;
    font-size: 21px;
    -unity-font-style: bold;
    margin-top: 14px;
    padding-left: 24px;
    padding-right: 24px;
}

.icon-action-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.icon-action-button #action-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 10px;
}

.icon-action-button .action-label {
    -unity-font-style: bold;
}

.primary-action {
    background-color: rgb(90, 157, 103);
    color: white;
}

.secondary-action {
    background-color: rgb(224, 242, 224);
    color: rgb(53, 103, 64);
    border-width: 1px;
    border-color: rgb(175, 211, 179);
}

.danger-action {
    background-color: rgb(253, 229, 225);
    color: rgb(156, 72, 62);
}

.ghost-action {
    background-color: rgba(255, 255, 255, 0);
    color: rgb(91, 105, 95);
}

.compact-action {
    min-height: 48px;
    margin-top: 6px;
    font-size: 18px;
}

.icon-button {
    width: 54px;
    height: 54px;
    min-width: 54px;
    min-height: 54px;
    border-radius: 27px;
    border-width: 1px;
    border-color: rgba(80, 106, 84, 0.14);
    background-color: rgba(255, 253, 247, 0.96);
    color: rgb(56, 83, 62);
    font-size: 32px;
    -unity-font-style: bold;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.icon-button #icon-image {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    flex-shrink: 0;
    align-self: center;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.bottom-nav {
    height: 112px;
    min-height: 112px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-around;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 8px;
    padding-top: 8px;
    background-color: rgb(255, 253, 248);
    border-top-width: 1px;
    border-top-color: rgba(69, 95, 75, 0.13);
}

.nav-button {
    width: 18%;
    height: 82px;
    min-height: 60px;
    border-width: 0;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(113, 125, 116);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.nav-button #nav-icon {
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    flex-shrink: 0;
    align-self: center;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.nav-button #nav-label {
    font-size: 16px;
    margin-top: 3px;
}

.selected-nav {
    color: rgb(71, 132, 83);
    background-color: rgb(232, 244, 229);
}

.selected-nav #nav-icon {
    -unity-background-image-tint-color: rgb(71, 132, 83);
}

.map-marker #icon-image {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.raised-nav {
    height: 96px;
    margin-bottom: 13px;
    border-radius: 48px;
    color: white;
    background-color: rgb(91, 159, 104);
    border-width: 6px;
    border-color: rgb(255, 253, 248);
}

.map-page {
    position: relative;
    flex-grow: 1;
}

.map-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(217, 234, 210);
}

.map-canvas, .map-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-top-overlay {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.map-top-overlay .compact-card {
    flex-grow: 1;
    margin-right: 12px;
}

.map-stats {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 18px;
    flex-direction: row;
    align-items: center;
    padding: 16px;
    margin-bottom: 0;
}

.map-stats .metric {
    margin-right: 10px;
}

.map-stats .action-button {
    flex-grow: 1;
    margin-top: 0;
}

.map-controls {
    position: absolute;
    right: 22px;
    top: 230px;
}

.map-controls .icon-button {
    margin-bottom: 10px;
}

.map-marker {
    position: absolute;
    width: 60px;
    height: 60px;
    min-width: 60px;
    min-height: 60px;
    margin-left: -30px;
    margin-top: -30px;
    border-radius: 30px;
    border-width: 5px;
    border-color: white;
    color: white;
    background-color: rgb(90, 157, 103);
    padding: 0;
    font-size: 32px;
}

.marker-landmark { background-color: rgb(85, 158, 200); }
.marker-player { background-color: rgb(78, 127, 78); width: 70px; height: 70px; }

.metric-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 18px;
}

.metric {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 86px;
}

.metric-value {
    font-size: 29px;
    color: rgb(49, 78, 56);
    -unity-font-style: bold;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
}

.metric-label {
    font-size: 16px;
    color: rgb(107, 119, 110);
}

.progress-track {
    height: 12px;
    min-height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background-color: rgb(226, 231, 222);
    margin-top: 14px;
}

.progress-fill {
    height: 12px;
    border-radius: 6px;
    background-color: rgb(97, 168, 109);
}

.walk-hero, .companion-banner, .collection-progress {
    background-color: rgb(234, 245, 226);
}

.summary-hero {
    background-color: rgb(255, 241, 197);
}

.discovery-card, .memory-card {
    background-color: rgb(228, 244, 250);
}

.journey-banner {
    background-color: rgb(255, 232, 236);
}

.journey-banner #banner-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.discovery-line {
    min-height: 70px;
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 95, 75, 0.10);
}

.discovery-badge {
    width: 48px;
    height: 48px;
    margin-right: 14px;
    border-radius: 24px;
    background-color: rgb(239, 246, 229);
    color: rgb(80, 138, 91);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.permission-row, .list-card {
    flex-direction: row;
    align-items: center;
    padding: 16px;
    border-radius: 20px;
    margin-bottom: 10px;
}

.permission-row #permission-glyph {
    width: 48px;
    font-size: 32px;
    color: rgb(83, 144, 95);
}

.permission-row #permission-check {
    font-size: 26px;
    color: rgb(83, 144, 95);
}

.onboarding-page {
    background-color: rgb(231, 243, 229);
}

.onboarding-art {
    flex-grow: 1;
    min-height: 300px;
}

.onboarding-sheet {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
    padding: 30px;
}

.list-thumb {
    width: 92px;
    height: 92px;
    margin-right: 16px;
    border-radius: 20px;
    background-color: rgb(239, 246, 229);
}

.list-card .action-button {
    width: 90px;
    margin-left: 10px;
}

.ready-card {
    border-color: rgb(235, 172, 65);
    background-color: rgb(255, 246, 214);
}

.reveal-stage {
    min-height: 650px;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 236, 240);
}

.reveal-companion {
    width: 310px;
    height: 360px;
    margin-top: 12px;
    margin-bottom: 18px;
}

.companion-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.companion-card {
    width: 48%;
    min-height: 290px;
    margin-bottom: 18px;
    padding: 14px;
    border-radius: 24px;
    background-color: rgb(255, 253, 247);
    border-width: 1px;
    border-color: rgba(77, 105, 83, 0.13);
    flex-direction: column;
    align-items: stretch;
}

.companion-image {
    height: 190px;
    border-radius: 18px;
    background-color: rgb(236, 246, 229);
    margin-bottom: 12px;
}

.locked-card {
    opacity: 0.52;
    background-color: rgb(231, 229, 222);
}

.companion-stage {
    align-items: center;
    background-color: rgb(232, 245, 229);
}

.detail-companion {
    width: 360px;
    height: 410px;
}

.story-card, .scrapbook-card {
    background-color: rgb(255, 248, 224);
}

.landmark-hero, .journey-detail-image {
    height: 360px;
    border-radius: 28px;
    margin-bottom: 18px;
}

.journey-card {
    min-height: 190px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    padding: 14px;
    border-radius: 24px;
    background-color: rgb(255, 253, 247);
    border-width: 1px;
    border-color: rgba(77, 105, 83, 0.13);
}

.journey-image {
    width: 150px;
    height: 150px;
    border-radius: 20px;
    margin-right: 16px;
}

.overlay-scrim, .tray-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(28, 43, 32, 0.50);
    justify-content: center;
    align-items: center;
    padding: 32px;
}

.tray-scrim {
    justify-content: flex-end;
    padding: 0;
}

.modal-card {
    width: 100%;
    max-width: 620px;
    padding: 30px;
}

.discovery-tray {
    width: 100%;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
    padding: 30px;
}

.toast {
    max-width: 620px;
    min-height: 56px;
    margin: 24px;
    padding: 16px 24px;
    border-radius: 28px;
    background-color: rgb(45, 65, 51);
    color: white;
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ar-page {
    position: relative;
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(35, 54, 41);
}

.ar-backdrop, .photo-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: -80px;
    bottom: -80px;
}

.ar-top-bar {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 20px;
    flex-direction: row;
    align-items: center;
}

.ar-top-bar > .column, .ar-top-bar > .title {
    flex-grow: 1;
    margin-left: 12px;
    color: white;
}

.ar-top-bar .title, .ar-top-bar .ar-alert {
    color: white;
}

.ar-alert {
    font-size: 17px;
    background-color: rgba(37, 51, 40, 0.64);
    border-radius: 15px;
    padding: 6px 10px;
    white-space: normal;
}

.ar-guide {
    position: absolute;
    left: 60px;
    right: 60px;
    top: 145px;
    min-height: 54px;
    justify-content: center;
    align-items: center;
    border-radius: 27px;
    background-color: rgba(255, 253, 247, 0.88);
    padding: 10px 20px;
}

.ar-companion {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 31%;
    bottom: 19%;
}

.ar-bottom-controls {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.camera-shutter {
    width: 92px;
    height: 92px;
    border-radius: 46px;
    border-width: 7px;
    border-color: white;
    color: white;
    background-color: rgba(255, 255, 255, 0.25);
    font-size: 44px;
}

.photo-companion {
    position: absolute;
    width: 42%;
    height: 48%;
    left: 29%;
    top: 25%;
}

.photo-caption-card {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 132px;
    padding: 18px;
    border-radius: 20px;
    background-color: rgba(255, 253, 247, 0.92);
}

.photo-actions {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;
    flex-direction: row;
}

.photo-actions .action-button {
    flex-grow: 1;
    margin-left: 5px;
    margin-right: 5px;
}

.activity-dashboard-button {
    margin-right: 10px;
}

.activity-hero, .weekly-chart-card {
    background-color: rgb(234, 245, 226);
}

.activity-progress-label-row {
    margin-top: 6px;
}

.weekly-chart {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
    margin-bottom: 4px;
}

.weekly-chart-column {
    align-items: center;
    flex-grow: 1;
}

.weekly-chart-bar-track {
    width: 26px;
    height: 120px;
    border-radius: 13px;
    background-color: rgba(91, 121, 98, 0.10);
    overflow: hidden;
    justify-content: flex-end;
}

.weekly-chart-bar-fill {
    width: 100%;
    border-radius: 13px;
    background-color: rgb(180, 214, 174);
}

.weekly-chart-bar-fill-today {
    background-color: rgb(71, 132, 83);
}

.weekly-chart-bar-fill-future {
    background-color: transparent;
}

.weekly-chart-day-label {
    font-size: 15px;
    color: rgb(107, 119, 110);
    margin-top: 8px;
}

.weekly-chart-date-label {
    font-size: 17px;
    color: rgb(49, 78, 56);
    -unity-font-style: bold;
}

.weekly-chart-today-label {
    color: rgb(71, 132, 83);
}

.average-pill {
    align-items: center;
    justify-content: center;
    margin-top: 14px;
    padding: 12px;
    border-radius: 20px;
    background-color: rgba(255, 253, 247, 0.85);
}

.average-pill-text {
    font-size: 19px;
    color: rgb(53, 103, 64);
    -unity-font-style: bold;
}

@media (max-width: 760px) {
    .title { font-size: 33px; }
    .body { font-size: 18px; }
    .content-page { padding-left: 22px; padding-right: 22px; }
    .bottom-nav { height: 104px; min-height: 104px; }
    .companion-card { width: 49%; }
    .landmark-hero, .journey-detail-image { height: 300px; }
}
