/* Bạn Bước — v0.dev visual language, implemented with Unity UI Toolkit. */

.app-root {
    flex-grow: 1;
    color: rgb(42, 63, 49);
    background-color: rgb(249, 246, 235);
    -unity-font-definition: url("../../Art/UI/Fonts/Nunito-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.ar-panel-root { background-color: rgba(0, 0, 0, 0); }

.safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(249, 246, 235);
}

.page {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.content-page {
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 24px;
}

.row { flex-direction: row; }
.column { flex-direction: column; flex-grow: 1; min-width: 0; }

.title {
    font-size: 58px;
    line-height: 62px;
    color: rgb(42, 63, 49);
    white-space: normal;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.subtitle {
    font-size: 34px;
    line-height: 40px;
    color: rgb(42, 63, 49);
    white-space: normal;
    -unity-font-style: bold;
}

.body {
    font-size: 26px;
    line-height: 36px;
    color: rgb(105, 120, 109);
    white-space: normal;
    margin-top: 4px;
    -unity-font-style: bold;
}

.eyebrow {
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(84, 190, 107);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.section-title {
    margin-top: 30px;
    margin-bottom: 14px;
    font-size: 32px;
    color: rgb(42, 63, 49);
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
    -unity-font-style: bold;
}

.small-label { font-size: 21px; color: rgb(105, 120, 109); -unity-font-style: bold; }
.small-strong-label { font-size: 23px; color: rgb(42, 63, 49); -unity-font-style: bold; }

.card {
    background-color: rgb(255, 253, 247);
    border-radius: 52px;
    padding: 30px;
    margin-bottom: 22px;
    border-width: 2px;
    border-color: rgba(112, 125, 107, 0.17);
}

.elevated-card {
    border-bottom-width: 7px;
    border-bottom-color: rgba(88, 105, 91, 0.13);
}

.floating-surface { background-color: rgba(255, 253, 247, 0.96); }
.divider { height: 2px; min-height: 2px; background-color: rgb(232, 232, 218); margin-top: 24px; margin-bottom: 24px; }

.pill {
    min-height: 50px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 25px;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    background-color: rgb(239, 241, 230);
}

.pill-label { font-size: 21px; color: rgb(42, 63, 49); -unity-font-style: bold; white-space: normal; }

.action-button {
    min-height: 82px;
    border-radius: 41px;
    border-width: 0;
    font-size: 27px;
    -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf");
    -unity-font-style: bold;
    margin-top: 16px;
    padding-left: 30px;
    padding-right: 30px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.action-button:active { scale: 0.98 0.98; }
.primary-action { background-color: rgb(84, 190, 107); color: white; }
.secondary-action { background-color: rgb(242, 238, 220); color: rgb(42, 63, 49); border-width: 2px; border-color: rgb(225, 226, 211); }
.blossom-action { background-color: rgb(250, 218, 224); color: rgb(143, 72, 86); }
.danger-action { background-color: rgb(252, 226, 222); color: rgb(172, 70, 63); }
.disabled-action { background-color: rgb(232, 231, 222); color: rgb(119, 128, 120); }
.text-action { background-color: rgba(0, 0, 0, 0); color: rgb(84, 160, 99); min-height: 52px; margin-top: 6px; }

.icon-action-button { flex-direction: row; align-items: center; justify-content: center; }
.icon-action-button #action-icon { width: 34px; height: 34px; min-width: 34px; min-height: 34px; flex-shrink: 0; margin-right: 12px; }
.icon-action-button .action-label { font-size: 27px; -unity-font-style: bold; }
.half-action { width: 48%; margin-left: 1%; margin-right: 1%; }

.icon-button {
    width: 82px;
    height: 82px;
    min-width: 82px;
    min-height: 82px;
    border-radius: 41px;
    border-width: 2px;
    border-color: rgba(80, 106, 84, 0.15);
    background-color: rgba(255, 253, 247, 0.96);
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.icon-button:active { scale: 0.95 0.95; }
.icon-button #icon-image { width: 38px; height: 38px; min-width: 38px; min-height: 38px; align-self: center; }
.small-round-control { width: 66px; height: 66px; min-width: 66px; min-height: 66px; border-radius: 33px; }
.small-round-control #icon-image { width: 30px; height: 30px; min-width: 30px; min-height: 30px; }
.dark-round-control { background-color: rgba(24, 34, 27, 0.58); border-width: 0; }

/* Global v0 status and bottom navigation */
.top-status-bar {
    height: 78px;
    min-height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.map-top-status-bar { position: absolute; left: 38px; right: 38px; top: 24px; margin-bottom: 0; }
.status-pill-group { align-items: center; }

.status-pill {
    height: 62px;
    min-height: 62px;
    flex-direction: row;
    align-items: center;
    padding: 5px 18px 5px 6px;
    margin-right: 12px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgba(98, 113, 100, 0.12);
    background-color: rgba(255, 253, 247, 0.94);
}

.status-icon-well { width: 48px; height: 48px; min-width: 48px; min-height: 48px; border-radius: 24px; align-items: center; justify-content: center; margin-right: 10px; }
.status-icon { width: 27px; height: 27px; }
.coin-status-pill .status-icon-well { background-color: rgb(250, 220, 116); }
.distance-status-pill .status-icon-well { background-color: rgb(84, 190, 107); }
.status-value { font-size: 27px; color: rgb(42, 63, 49); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }

.profile-button {
    width: 68px;
    height: 68px;
    min-width: 68px;
    min-height: 68px;
    border-radius: 34px;
    border-width: 5px;
    border-color: rgb(255, 253, 247);
    background-color: rgb(250, 218, 224);
    align-items: center;
    justify-content: center;
}

.profile-button:active { scale: 0.95 0.95; }
.profile-initial { font-size: 30px; color: rgb(143, 72, 86); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }

.bottom-nav {
    height: 128px;
    min-height: 128px;
    flex-direction: row;
    align-items: stretch;
    margin-left: 30px;
    margin-right: 30px;
    margin-bottom: 24px;
    padding: 12px;
    border-radius: 52px;
    background-color: rgba(255, 253, 247, 0.98);
    border-width: 2px;
    border-color: rgba(100, 115, 100, 0.16);
    overflow: hidden;
}

.nav-button {
    width: auto;
    min-width: 0;
    height: 94px;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0;
    border-radius: 38px;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.nav-button:active { scale: 0.95 0.95; }
.nav-button #nav-icon { width: 40px; height: 40px; min-width: 40px; min-height: 40px; }
.nav-button #nav-label { font-size: 33px; line-height: 38px; margin-top: 3px; color: rgb(141, 151, 143); white-space: nowrap; }
.selected-nav { background-color: rgba(84, 190, 107, 0.14); }
.selected-nav #nav-label { color: rgb(69, 167, 90); }

/* Map */
.map-page { flex-grow: 1; position: relative; justify-content: space-between; }
.map-viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; background-color: rgb(222, 239, 217); }
.map-canvas, .map-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

.location-pill {
    position: absolute;
    top: 116px;
    align-self: center;
    min-height: 62px;
    flex-direction: row;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 31px;
    border-width: 2px;
    border-color: rgba(93, 108, 94, 0.12);
}

.location-pill-icon { width: 30px; height: 30px; margin-right: 10px; }
.location-pill-label { font-size: 27px; color: rgb(42, 63, 49); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }

.landmark-map-marker {
    position: absolute;
    width: 124px;
    min-height: 112px;
    margin-left: -62px;
    margin-top: -56px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    align-items: center;
}

.landmark-map-marker:active { scale: 0.95 0.95; }
.marker-pin { width: 78px; height: 78px; min-width: 78px; min-height: 78px; border-radius: 39px 39px 10px 39px; border-width: 5px; border-color: rgb(255, 253, 247); align-items: center; justify-content: center; }
.marker-pin #marker-icon { width: 38px; height: 38px; }
.marker-accent-0 .marker-pin { background-color: rgb(84, 190, 107); }
.marker-accent-1 .marker-pin { background-color: rgb(250, 220, 116); }
.marker-accent-2 .marker-pin { background-color: rgb(196, 229, 242); }
.marker-distance { margin-top: 8px; padding: 5px 14px; border-radius: 18px; background-color: rgba(255, 253, 247, 0.94); font-size: 19px; color: rgb(42, 63, 49); -unity-font-style: bold; }
.nearby-badge { position: absolute; width: 36px; height: 36px; right: -12px; top: -12px; border-radius: 18px; border-width: 4px; border-color: rgb(255, 253, 247); background-color: rgb(250, 218, 224); align-items: center; justify-content: center; }
.nearby-icon { width: 18px; height: 18px; }

.player-map-marker { position: absolute; width: 132px; height: 132px; min-width: 132px; min-height: 132px; margin-left: -66px; margin-top: -66px; border-radius: 66px; border-width: 8px; border-color: rgb(255, 253, 247); background-color: rgb(255, 253, 247); padding: 0; overflow: visible; align-items: center; justify-content: center; }
.player-pulse { position: absolute; left: -30px; right: -30px; top: -30px; bottom: -30px; border-radius: 96px; background-color: rgba(84, 190, 107, 0.24); }
.player-avatar-well { width: 112px; height: 112px; border-radius: 56px; overflow: hidden; position: relative; }
.player-companion { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

.map-controls { position: absolute; right: 34px; top: 48%; }
.map-round-control { margin-bottom: 16px; }
.map-photo-button { background-color: rgb(250, 218, 224); }

.walk-control-card { position: absolute; left: 30px; right: 30px; bottom: 20px; margin-bottom: 0; padding: 28px; border-radius: 50px; }
/* Docked (real WebView map) variant: the base rule's left/right are sizing constraints for its usual
   position: absolute, but for a relative/in-flow element they become offsets instead - since the card is
   already stretched to the container's width by the flex layout, "left: 30px" alone would shift the whole
   card 30px right without shrinking it, pushing its right edge off-screen. Higher-specificity combined
   selector resets position/left/right/bottom and re-expresses the same 30px inset as margins instead. */
.walk-control-card.map-bottom-bar {
    position: relative;
    left: 0;
    right: 0;
    bottom: 0;
    margin-left: 30px;
    margin-right: 30px;
}
.walk-summary-row { align-items: center; justify-content: space-between; }
.walk-main-metric { flex-grow: 1; }
.walk-distance-line { flex-direction: row; align-items: baseline; }
.walk-distance-value { font-size: 62px; line-height: 65px; color: rgb(42, 63, 49); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }
.walk-distance-unit { font-size: 28px; color: rgb(105, 120, 109); margin-left: 8px; }
.walk-mini-metric { flex-grow: 0; width: 150px; min-height: 76px; }
.walk-mini-metric .metric-value { font-size: 34px; }
.sun-value .metric-value { color: rgb(197, 148, 34); }
.blossom-value .metric-value { color: rgb(175, 85, 102); }
.walk-goal-row { align-items: center; margin-top: 17px; }
.walk-goal-icon { width: 31px; height: 31px; margin-right: 13px; }
.walk-progress { flex-grow: 1; margin-top: 0; }
.walk-goal-label { width: 124px; margin-left: 13px; font-size: 20px; color: rgb(105, 120, 109); }
.walk-toggle-action { margin-top: 20px; }

/* Content screens */
.screen-header { min-height: 126px; flex-direction: row; align-items: center; padding-bottom: 18px; }
.screen-header-copy { margin-left: 14px; }
.screen-header .title { font-size: 55px; }
.screen-header .body { font-size: 23px; line-height: 29px; }
.header-chip { flex-grow: 0; min-width: 150px; min-height: 62px; margin-top: 0; margin-left: 14px; padding-left: 22px; padding-right: 22px; }
.header-chip .action-label { font-size: 23px; }
.header-chip #action-icon { width: 28px; height: 28px; min-width: 28px; min-height: 28px; }
.blossom-chip { background-color: rgb(250, 218, 224); color: rgb(143, 72, 86); }
.sun-chip { background-color: rgb(250, 220, 116); color: rgb(123, 91, 20); }
.screen-scroll { flex-grow: 1; min-height: 0; padding-bottom: 30px; }

.metric { flex-grow: 1; align-items: center; justify-content: center; min-height: 88px; }
.metric-value { font-size: 39px; color: rgb(42, 63, 49); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }
.metric-label { font-size: 19px; color: rgb(105, 120, 109); -unity-font-style: bold; }

.progress-track { height: 17px; min-height: 17px; border-radius: 9px; overflow: hidden; background-color: rgb(239, 237, 222); margin-top: 14px; }
.progress-fill { height: 17px; border-radius: 9px; background-color: rgb(84, 190, 107); }

/* Onboarding */
.onboarding-page { background-color: rgb(225, 241, 221); }
.onboarding-art { position: absolute; left: 0; right: 0; top: 0; bottom: 690px; }
.onboarding-brand { position: absolute; left: 42px; top: 40px; flex-direction: row; align-items: center; padding: 13px 20px; border-radius: 30px; background-color: rgba(255, 253, 247, 0.90); }
.brand-icon { width: 32px; height: 32px; margin-right: 10px; }
.brand-wordmark { font-size: 24px; color: rgb(42, 63, 49); letter-spacing: 2px; }
.onboarding-sheet { position: absolute; left: 0; right: 0; bottom: 0; min-height: 700px; margin-bottom: 0; padding: 44px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-top-left-radius: 68px; border-top-right-radius: 68px; }
.sheet-handle { width: 76px; height: 8px; min-height: 8px; border-radius: 4px; background-color: rgb(221, 222, 210); align-self: center; margin-bottom: 26px; }
.starter-reveal { height: 320px; margin-top: 18px; margin-bottom: 10px; border-radius: 44px; background-color: rgb(232, 245, 229); overflow: hidden; position: relative; }
.reveal-companion { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.name-field { margin-top: 24px; margin-bottom: 8px; font-size: 25px; }
.name-field > .unity-text-field__input { min-height: 72px; padding: 17px 20px; border-radius: 28px; border-width: 2px; border-color: rgb(225, 226, 211); background-color: rgb(255, 253, 247); }

/* Walk result */
.walk-result-page { background-color: rgb(47, 94, 61); padding: 42px; }
.walk-result-close { position: absolute; right: 38px; top: 34px; }
.walk-result-content { flex-grow: 1; align-items: center; justify-content: center; padding-top: 76px; }
.walk-result-content > .title, .walk-result-content > .body, .walk-result-content > .eyebrow { color: white; -unity-text-align: middle-center; }
.result-sparkle { width: 100px; height: 100px; margin-bottom: 8px; }
.walk-result-card { width: 100%; margin-top: 32px; padding: 34px; }
.result-metrics { justify-content: space-between; }
.result-metric { width: 33%; }
.growth-reward-row { min-height: 94px; align-items: center; border-bottom-width: 2px; border-bottom-color: rgb(236, 234, 221); }
.growth-reward-pet { width: 78px; height: 78px; margin-right: 16px; }
.growth-reward-row .subtitle { font-size: 29px; }
.growth-reward-row .body { font-size: 20px; }
.growth-reward-value { font-size: 25px; color: rgb(84, 190, 107); }

/* Companions */
.featured-companion { padding: 0; overflow: hidden; border-radius: 54px; }
.featured-companion-hero { min-height: 290px; padding: 30px; align-items: center; }
.accent-surface-0 { background-color: rgb(232, 245, 229); }
.accent-surface-1 { background-color: rgb(251, 239, 194); }
.accent-surface-2 { background-color: rgb(220, 239, 247); }
.accent-surface-3 { background-color: rgb(250, 228, 232); }
.featured-portrait-well { width: 250px; height: 250px; min-width: 250px; border-radius: 125px; background-color: rgba(255, 253, 247, 0.62); overflow: hidden; position: relative; margin-right: 28px; }
.featured-companion-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.featured-copy .title { font-size: 49px; line-height: 52px; flex-grow: 1; }
.featured-copy .body { font-size: 22px; line-height: 29px; max-height: 94px; overflow: hidden; }
.featured-name-row { align-items: center; }
.stage-pill { background-color: rgb(255, 253, 247); min-height: 42px; margin-left: 10px; padding-left: 14px; padding-right: 14px; }
.stage-pill .pill-label { font-size: 18px; }
.stage-dots { flex-direction: row; align-items: center; margin-top: 18px; }
.stage-dot { width: 18px; height: 18px; border-radius: 9px; background-color: rgb(255, 253, 247); }
.stage-dot-active { background-color: rgb(84, 190, 107); }
.stage-chevron { width: 21px; height: 21px; margin-left: 5px; margin-right: 5px; opacity: 0.4; }
.featured-growth { padding: 30px; }
.growth-header { align-items: center; justify-content: space-between; }
.growth-label { align-items: center; }
.growth-icon { width: 29px; height: 29px; margin-right: 8px; }
.featured-actions { justify-content: space-between; }
.owned-companion-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 6px; }
.owned-companion-card { width: 31.5%; min-height: 238px; margin-bottom: 18px; padding: 10px; border-radius: 34px; border-width: 2px; border-color: rgba(105, 120, 109, 0.16); background-color: rgb(255, 253, 247); align-items: center; }
.selected-companion-card { border-width: 4px; border-color: rgb(84, 190, 107); background-color: rgb(240, 249, 236); }
.companion-thumb-well { width: 100%; height: 156px; border-radius: 26px; overflow: hidden; position: relative; }
.companion-thumb { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.companion-thumb-name { margin-top: 8px; font-size: 23px; color: rgb(42, 63, 49); -unity-font-style: bold; -unity-text-align: middle-center; }
.companion-thumb-stage { font-size: 18px; color: rgb(105, 120, 109); }
.locked-companion-row { min-height: 116px; padding: 18px; border-style: dashed; flex-direction: row; align-items: center; background-color: rgba(255, 253, 247, 0.68); }
.locked-icon-well { width: 82px; height: 82px; min-width: 82px; border-radius: 26px; background-color: rgb(239, 237, 222); align-items: center; justify-content: center; margin-right: 18px; }
.locked-icon { width: 36px; height: 36px; opacity: 0.55; }
.locked-companion-row .subtitle { font-size: 28px; }
.locked-companion-row .body { font-size: 20px; line-height: 26px; }
.companion-story-card { background-color: rgb(255, 247, 219); }
.companion-detail-locked { align-items: center; padding: 50px; }
.detail-lock-icon { width: 90px; height: 90px; margin-bottom: 24px; }

/* Shop */
.shop-food-card { min-height: 210px; flex-direction: row; align-items: center; padding: 22px; }
.food-art-well { width: 170px; height: 170px; min-width: 170px; min-height: 170px; border-radius: 40px; margin-right: 24px; overflow: hidden; position: relative; flex-shrink: 0; }
.food-art { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.food-copy .subtitle { font-size: 36px; }
.food-copy .body { font-size: 21px; line-height: 27px; max-height: 60px; overflow: hidden; }
.food-reward { align-items: center; margin-top: 10px; }
.food-reward-icon { width: 25px; height: 25px; margin-right: 7px; }
.food-reward-label { font-size: 21px; color: rgb(105, 120, 109); }
.price-pill { min-width: 124px; min-height: 66px; flex-direction: row; align-items: center; justify-content: center; border-radius: 33px; border-width: 0; background-color: rgb(84, 190, 107); margin-left: 18px; padding-left: 17px; padding-right: 19px; }
.price-pill:active { scale: 0.95 0.95; }
.price-icon { width: 28px; height: 28px; margin-right: 8px; }
.price-label { font-size: 28px; color: white; -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); }
.shop-note-card { flex-direction: row; align-items: center; background-color: rgb(232, 245, 229); }
.shop-note-icon { width: 48px; height: 48px; min-width: 48px; margin-right: 18px; }

/* Landmark */
.landmark-hero-card { height: 480px; min-height: 480px; padding: 0; margin-bottom: 25px; border-radius: 54px; overflow: hidden; }
.landmark-hero { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.landmark-distance-pill { position: absolute; left: 24px; bottom: 24px; background-color: rgba(255, 253, 247, 0.94); }
.near-pill { background-color: rgb(232, 245, 229); }
.far-pill { background-color: rgb(250, 239, 210); }
.story-section { padding: 26px; }
.story-heading { align-items: center; margin-bottom: 8px; }
.story-heading .subtitle { font-size: 31px; }
.story-icon { width: 38px; height: 38px; margin-right: 14px; }
.history-card { background-color: rgb(232, 245, 229); }
.architecture-card { background-color: rgb(220, 239, 247); }
.fact-card { background-color: rgb(255, 247, 219); }

.info-row { min-height: 106px; flex-direction: row; align-items: center; padding: 18px; margin-bottom: 14px; border-radius: 32px; background-color: rgb(247, 244, 232); }
.info-icon-well { width: 72px; height: 72px; min-width: 72px; border-radius: 25px; background-color: rgba(255, 253, 247, 0.8); align-items: center; justify-content: center; margin-right: 17px; }
.info-icon { width: 34px; height: 34px; }
.info-row .subtitle { font-size: 28px; }
.info-row .body { font-size: 20px; line-height: 26px; }
.primary-info { background-color: rgb(232, 245, 229); }
.blossom-info { background-color: rgb(250, 228, 232); }
.sun-info { background-color: rgb(255, 247, 219); }

/* Journey */
.journey-stats { justify-content: space-between; margin-bottom: 12px; }
.journey-stat-card, .activity-summary-card { width: 31.5%; flex-grow: 0; min-height: 128px; border-radius: 34px; background-color: rgb(255, 253, 247); border-width: 2px; border-bottom-width: 6px; border-color: rgba(105, 120, 109, 0.15); }
.journey-stat-card .metric-value { font-size: 45px; }
.passport-card { flex-direction: row; justify-content: space-between; padding: 22px; }
.passport-stamp { width: 31%; min-height: 168px; padding: 14px; align-items: center; justify-content: center; border-radius: 34px; border-width: 3px; border-style: dashed; border-color: rgb(221, 222, 210); background-color: rgb(247, 244, 232); }
.passport-stamp-collected { border-style: solid; border-color: rgba(84, 190, 107, 0.5); background-color: rgb(232, 245, 229); }
.passport-stamp-icon { width: 56px; height: 56px; margin-bottom: 12px; }
.passport-stamp-label { font-size: 18px; color: rgb(42, 63, 49); white-space: normal; -unity-text-align: middle-center; }
.journey-memory-card { height: 410px; min-height: 410px; margin-bottom: 24px; padding: 0; border-radius: 52px; overflow: hidden; border-width: 2px; border-bottom-width: 7px; border-color: rgba(75, 91, 79, 0.18); background-color: rgb(42, 63, 49); }
.journey-memory-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 0.88; }
.journey-memory-overlay { position: absolute; left: 0; right: 0; bottom: 0; min-height: 180px; padding: 25px; background-color: rgba(31, 48, 37, 0.78); }
.journey-memory-overlay .subtitle, .journey-memory-overlay .body { color: white; }
.journey-memory-overlay .body { font-size: 21px; max-height: 60px; overflow: hidden; }
.journey-date-pill { background-color: rgba(255, 253, 247, 0.92); min-height: 43px; margin-bottom: 9px; }
.journey-date-pill .pill-label { font-size: 18px; }
.journey-empty-card { align-items: center; padding: 54px 34px; }
.journey-empty-icon { width: 80px; height: 80px; margin-bottom: 18px; }
.journey-photo-frame { padding: 16px; background-color: white; overflow: hidden; }
.journey-detail-image { height: 560px; border-radius: 40px; }
.journey-photo-caption { min-height: 62px; padding-top: 17px; font-size: 23px; color: rgb(42, 63, 49); -unity-text-align: middle-center; -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); }
.scrapbook-card { background-color: rgb(255, 247, 219); }

/* Activity dashboard */
.activity-record-card { align-items: stretch; padding: 36px; }
.activity-record-card > .title { font-size: 46px; -unity-text-align: middle-center; }
.activity-ring { width: 520px; height: 520px; align-self: center; align-items: center; justify-content: center; position: relative; }
.activity-ring-value { position: absolute; top: 190px; font-size: 66px; color: rgb(42, 63, 49); -unity-font-definition: url("../../Art/UI/Fonts/Baloo2-VariableFont_wght.ttf"); -unity-font-style: bold; }
.activity-ring-label { position: absolute; top: 277px; font-size: 21px; letter-spacing: 2px; color: rgb(42, 63, 49); }
.activity-goal-pill { position: absolute; top: 323px; background-color: rgb(232, 245, 229); }
.activity-goal-pill .pill-label { color: rgb(84, 170, 100); }
.weekly-chart { height: 280px; min-height: 280px; flex-direction: row; align-items: flex-end; justify-content: space-between; margin-top: 8px; padding-top: 20px; border-top-width: 2px; border-top-color: rgba(84, 190, 107, 0.32); }
.weekly-chart-column { width: 14.28%; align-items: center; }
.weekly-chart-bar-track { width: 48px; height: 174px; border-radius: 24px 24px 4px 4px; background-color: rgba(84, 190, 107, 0.08); overflow: hidden; justify-content: flex-end; }
.weekly-chart-bar-fill { width: 100%; min-height: 3px; border-radius: 24px 24px 4px 4px; background-color: rgb(190, 225, 195); }
.weekly-chart-bar-fill-today { background-color: rgb(84, 190, 107); }
.weekly-chart-bar-fill-future { background-color: rgb(239, 237, 222); }
.weekly-chart-day-label { font-size: 18px; color: rgb(105, 120, 109); margin-top: 8px; }
.weekly-chart-date-label { font-size: 20px; color: rgb(141, 151, 143); }
.weekly-chart-today-label { color: rgb(42, 63, 49); }
.average-pill { align-self: stretch; margin-top: 18px; background-color: rgb(241, 247, 236); }
.average-pill .pill-label { color: rgb(84, 160, 99); font-size: 24px; }
.activity-summary-row { justify-content: space-between; margin-top: 2px; margin-bottom: 22px; }
.activity-summary-card .metric-value { font-size: 35px; }
.activity-friends-card { flex-direction: row; align-items: center; background-color: rgb(232, 245, 229); }
.activity-friends-icon { width: 54px; height: 54px; min-width: 54px; margin-right: 20px; }

/* Sheets, dialogs, notifications */
.overlay-scrim, .tray-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(28, 43, 32, 0.54); justify-content: center; align-items: center; padding: 38px; }
.tray-scrim { justify-content: flex-end; padding: 0; }
.modal-card { width: 100%; max-width: 720px; padding: 40px; position: relative; }
.modal-close { position: absolute; right: 22px; top: 22px; }
.discovery-tray { width: 100%; margin-bottom: 0; padding: 38px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-top-left-radius: 64px; border-top-right-radius: 64px; }
.food-companion-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 20px; }
.food-companion-choice { width: 31.5%; min-height: 190px; margin-bottom: 16px; padding: 10px; border-radius: 32px; border-width: 2px; border-color: rgb(225, 226, 211); background-color: rgb(247, 244, 232); align-items: center; }
.food-choice-well { width: 100%; height: 132px; border-radius: 26px; overflow: hidden; margin-bottom: 6px; position: relative; }
.food-choice-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.food-choice-label { font-size: 21px; color: rgb(42, 63, 49); }
.toast { max-width: 720px; min-height: 70px; margin: 24px; padding: 18px 28px; border-radius: 35px; background-color: rgb(42, 63, 49); color: white; font-size: 24px; -unity-text-align: middle-center; white-space: normal; }

/* Pet AR / Landmark Memory overlay */
.ar-page { position: relative; flex-grow: 1; overflow: hidden; background-color: rgba(0, 0, 0, 0); }
.ar-top-bar { position: absolute; left: 32px; right: 32px; top: 28px; flex-direction: row; align-items: center; justify-content: space-between; }
.ar-top-pill { min-height: 64px; flex-direction: row; align-items: center; padding: 10px 22px; border-radius: 32px; background-color: rgba(22, 31, 25, 0.52); }
.ar-top-pill .title { color: white; font-size: 27px; line-height: 34px; }
.ar-top-pill .ar-alert { color: rgba(255, 255, 255, 0.82); font-size: 18px; margin-left: 10px; }
.ar-scanning-frame { position: absolute; width: 560px; height: 560px; left: 50%; top: 47%; margin-left: -280px; margin-top: -280px; border-width: 5px; border-color: rgba(255, 255, 255, 0.78); border-radius: 50px; }
.ar-scan-controls { position: absolute; left: 70px; right: 70px; bottom: 100px; align-items: center; }
.ar-instruction-pill { min-height: 66px; flex-direction: row; align-items: center; padding: 12px 24px; border-radius: 33px; background-color: rgba(255, 253, 247, 0.94); }
.ar-instruction-pill .body { color: rgb(42, 63, 49); font-size: 23px; margin-top: 0; }
.ar-instruction-icon { width: 31px; height: 31px; margin-right: 11px; }
.ar-reveal-button { width: 100%; max-width: 650px; }
.ar-story-sheet { position: absolute; left: 0; right: 0; bottom: 0; min-height: 600px; padding: 38px 42px 48px 42px; border-top-left-radius: 68px; border-top-right-radius: 68px; background-color: rgba(255, 253, 247, 0.98); }
.ar-story-sheet .body { color: rgb(42, 63, 49); font-size: 27px; line-height: 39px; min-height: 190px; }
.ar-story-heading { flex-direction: row; align-items: center; }
.ar-story-heading-icon { width: 30px; height: 30px; margin-right: 10px; }
.ar-page-dots { flex-direction: row; align-items: center; justify-content: center; margin-top: 20px; margin-bottom: 20px; }
.ar-page-dot { width: 14px; height: 14px; border-radius: 7px; margin-left: 6px; margin-right: 6px; background-color: rgb(225, 226, 211); }
.ar-page-dot-active { width: 44px; background-color: rgb(84, 190, 107); }
.ar-story-actions { flex-direction: row; justify-content: space-between; }
.ar-story-actions .small-round-control { margin-top: 16px; margin-right: 14px; }
.ar-story-actions .action-button { flex-grow: 1; }
.ar-collected { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; padding: 70px; background-color: rgba(21, 31, 24, 0.76); }
.ar-collected .title, .ar-collected .body { color: white; -unity-text-align: middle-center; }
.ar-stamp-medallion { width: 250px; height: 250px; border-radius: 125px; border-width: 10px; border-color: rgba(255, 255, 255, 0.78); background-color: rgb(84, 190, 107); align-items: center; justify-content: center; margin-bottom: 30px; }
.ar-stamp-icon { width: 130px; height: 130px; }
.ar-collected-actions { width: 100%; max-width: 700px; margin-top: 26px; }
