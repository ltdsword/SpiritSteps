* text=auto eol=lf

# Unity YAML and source/config files must stay text-normalized across Windows clients.
*.asset text eol=lf
*.controller text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.unity text eol=lf
*.uss text eol=lf
*.uxml text eol=lf

# Imported media and model files are always binary.
*.fbx binary
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
*.wav binary
